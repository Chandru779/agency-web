# Canonical origin for sitemap, Open Graph, and metadata.
NEXT_PUBLIC_SITE_URL=https://miqode.com

# Server-only Resend API key. Never prefix this with NEXT_PUBLIC_.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender Resend uses to transmit mail.
# Until miqode.com is verified, use Resend's test sender:
#   onboarding@resend.dev
# After you verify miqode.com at https://resend.com/domains, switch this to
# an address on that domain, for example info@miqode.com.
# Do not use hello.miqode@gmail.com. That address receives enquiries.
CONTACT_FROM_EMAIL=

# Only needed while CONTACT_FROM_EMAIL is onboarding@resend.dev.
# Set this to the email on your Resend account. Test mail cannot go anywhere else.
# Leave it empty after the domain is verified. Enquiries then go to the studio
# address in src/lib/site.ts (hello.miqode@gmail.com).
CONTACT_TO_EMAIL=
